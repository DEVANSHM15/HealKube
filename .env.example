# HealKube Controller Configuration

# Kubernetes & Target Workload
KUBERNETES_MODE=local_mock            # Options: in_cluster, kubeconfig, local_mock
TARGET_NAMESPACE=healkube-demo
TARGET_DEPLOYMENT=demo-app
NAMESPACE_ALLOWLIST=healkube-demo
WORKLOAD_ALLOWLIST=demo-app

# Prometheus Configuration
PROMETHEUS_URL=http://prometheus-server.healkube-demo.svc.cluster.local:9090
PROMETHEUS_QUERY_TIMEOUT_SECONDS=5.0

# Polling and Detection Thresholds
POLL_INTERVAL_SECONDS=5.0
CONSECUTIVE_BREACHES_REQUIRED=3
ERROR_RATE_THRESHOLD_PERCENT=5.0      # % 5xx errors triggering alert
LATENCY_P95_THRESHOLD_SECONDS=1.0     # P95 latency threshold in seconds
CPU_UTILIZATION_THRESHOLD_PERCENT=85.0
MEMORY_UTILIZATION_THRESHOLD_PERCENT=90.0

# Dependency Health Check
DEPENDENCY_CHECK_ENABLED=true
DEPENDENCY_HEALTH_URL=http://demo-app.healkube-demo.svc.cluster.local/dependency-health

# Remediation & Policy Engine
DRY_RUN=true                          # MUST explicitly set to false to execute real K8s mutations
COOLDOWN_PERIOD_SECONDS=60.0          # Minimum time before another remediation on same workload
ALLOW_POD_RESTART=true
ALLOW_SCALING=true
MIN_REPLICAS=1
MAX_REPLICAS=5
SCALING_STEP=1
CHECK_HPA_EXISTS=true                 # Do not fight existing HPA

# Recovery Verification
VERIFICATION_WAIT_SECONDS=10.0
VERIFICATION_CHECKS_REQUIRED=3
VERIFICATION_INTERVAL_SECONDS=5.0
VERIFICATION_TIMEOUT_SECONDS=60.0

# Logging & Audit
LOG_LEVEL=INFO
AUDIT_LOG_FILE=audit_events.jsonl
STATUS_SERVER_PORT=8080
